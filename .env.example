# --- Optional: AI roasts via Google Gemini (free tier) -----------------------
# Get a key at https://aistudio.google.com/apikey . Server-side only: never
# prefix with NEXT_PUBLIC_. Without it, the rules-based house engine is used.
GEMINI_API_KEY=

# Model used first (verified free tier, Nov 2026). Override if Google changes models.
# GEMINI_MODEL=gemini-3.8-flash
# Tried once only if the first model returns 429 (quota). "none" disables.
# GEMINI_QUOTA_FALLBACK_MODEL=gemini-3.5-flash-lite
# Thinking level: minimal | low | medium | high | off (omit the setting)
# GEMINI_THINKING_LEVEL=low

# --- Share-link signing ------------------------------------------------------
# Signs share links so nobody can mint fake roasts on your domain.
# Required in production unless GEMINI_API_KEY is set (a secret is then
# derived from it). Generate: openssl rand -hex 32
ROAST_SIGNING_SECRET=

# --- Optional: canonical public URL (printed on cards, used for metadata) ----
# Defaults to Vercel's production URL, then the request host.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
