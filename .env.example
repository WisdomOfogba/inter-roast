# --- GitHub (strongly recommended) -------------------------------------------
# A token raises GitHub's limit from 60 to 5,000 requests/hour and enables the
# pinned-repos lookup. Create a fine-grained token with NO permissions (public
# read is enough): https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# --- Gemini (optional: AI-written roasts) ------------------------------------
# Free key: https://aistudio.google.com/apikey . Without it, the rules engine writes roasts.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_QUOTA_FALLBACK_MODEL=gemini-3.5-flash-lite   # used once after a 429; "none" disables
# GEMINI_THINKING_LEVEL=low                           # minimal | low | medium | high | off

# --- Share links (required in production unless GEMINI_API_KEY is set) ------
# Generate with: openssl rand -hex 32
ROAST_SIGNING_SECRET=

# --- Short share links (recommended) -----------------------------------------
# Upstash Redis via Vercel Storage/Marketplace (free: 256 MB, 500K commands/month).
# Without these, links fall back to long self-contained signed URLs.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# ...or any Redis connection string instead:
# REDIS_URL=rediss://default:password@host:6379
# Check your setup at /api/health?check=1

# --- Optional ------------------------------------------------------------------
# STATS_KEY=                                         # 12+ chars; then open /api/stats?key=YOUR_KEY
# NEXT_PUBLIC_SITE_URL=https://your-domain.example   # printed on share images
# ROAST_RATE_LIMIT_PER_MINUTE=4                      # per IP, per server instance
# GITHUB_CACHE_SECONDS=900                           # GitHub data freshness window; 0 disables caching
# GITHUB_API_BASE_URL=http://localhost:4010          # tests / offline dev with `npm run mock:github`
